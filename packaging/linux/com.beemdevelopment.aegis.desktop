[Desktop Entry]
Type=Application
Name=Aegis Desktop
GenericName=Two-factor authentication
Comment=Generate two-factor authentication codes (unofficial Aegis port)
Exec=aegis %f
Icon=com.beemdevelopment.aegis
Terminal=false
Categories=Utility;Security;
Keywords=2FA;TOTP;HOTP;OTP;authenticator;two-factor;
StartupWMClass=com-beemdevelopment-aegis-desktop-MainKt
MimeType=x-scheme-handler/otpauth;
SingleMainWindow=true
